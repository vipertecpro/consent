{
    "name": "vipertecpro/consent",
    "description": "App Tracking Transparency prompt and a cross-platform consent store (analytics, ads, personalisation) with events — native, hand-written, for NativePHP Mobile.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "vipertecpro",
            "email": "vipertecpro@gmail.com"
        }
    ],
    "homepage": "https://github.com/vipertecpro/consent",
    "keywords": ["nativephp", "mobile", "consent", "gdpr", "privacy", "att", "app-tracking-transparency", "idfa", "analytics", "ads"],
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Vipertecpro\\Consent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vipertecpro\\Consent\\ConsentServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "laravel/framework": "^12.0|^13.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
